---
// Codex Arcanum Game Page
// =======================

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout 
  title="Codex Arcanum: Idle RPG" 
  description="Codex Arcanum – Ein tiefgründiges Idle RPG über arkanes Wissen, Heldenparteien und endlose Aufstiege. Von Grimoire Interactive."
  ogImage="/assets/og-codex-arcanum.webp"
  canonical="https://grimoire-interactive.de/codex-arcanum/"
>
  <Header slot="header" />
  
  <!-- Game Hero -->
  <section class="game-hero animate-on-scroll" aria-labelledby="game-title">
    <div class="container game-hero__inner">
      <div class="game-hero__content">
        <div class="game-hero__meta">
          <span class="game-hero__tag game-hero__tag--publisher">A Grimoire Interactive Game</span>
          <span class="game-hero__tag">Idle RPG</span>
          <span class="game-hero__tag">Party System</span>
          <span class="game-hero__tag">Prestige / Ascension</span>
          <span class="game-hero__tag">Offline Progress</span>
        </div>
        <h1 id="game-title" class="game-hero__title">CODEX ARCANUM</h1>
        <p class="game-hero__subtitle">Verbotenes Wissen. Endlose Macht. Dein Grimoire wartet.</p>
        <p class="game-hero__description">
          Erkunde die verbotenen Seiten des <strong>Codex Arcanum</strong>. Rekrutiere ein Team aus arkanen Helden, meistere verbotene Zauberkünste, schmiede arte-fakte von mythischer Macht und steige durch die Ränge der Erleuchtung auf. Jede Wiedergeburt schreibt ein neues Kapitel deiner Legende.
        </p>
        
        <div class="game-hero__cta-group">
          <a href="https://play.google.com/store/apps/details?id=com.grimoireinteractive.codexarcanum" class="btn btn--primary btn--lg" rel="noopener noreferrer">
            <img src="/assets/google-play-badge.svg" alt="Auf Google Play erhalten" height="48">
          </a>
          <a href="https://apps.apple.com/app/idXXXXXXXXXX" class="btn btn--primary btn--lg" rel="noopener noreferrer" style="background: linear-gradient(135deg, #1a1a2e, #16213e); border-color: #0d1b2a;">
            <img src="/assets/app-store-badge.svg" alt="Im App Store laden" height="48">
          </a>
          <a href="https://discord.gg/grimoireinteractive" class="btn btn--secondary btn--lg" rel="noopener noreferrer">
            <span class="btn__text">Discord Community</span>
            <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.443.747-.698 1.113a18.27 18.27 0 0 0-5.481 0c-.256-.365-.489-.737-.699-1.113a.077.077 0 0 0-.079-.037 19.736 19.736 0 0 0-4.885 1.515.061.061 0 0 0-.031.022c-.939 1.564-1.482 3.433-1.517 3.706a.068.068 0 0 0 .005.103l.055.043c.06.051 4.178 3.546 4.499 3.759.115.076.254.076.369 0 .34-.223 4.547-3.717 4.614-3.774l.055-.043a.068.068 0 0 0 .005-.103c-.043-.359-.614-2.336-1.608-3.99a.061.061 0 0 0-.031-.022zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419z"/></svg>
          </a>
        </div>
        
        <div class="game-hero__platforms">
          <span>Verfügbar auf:</span>
          <span class="game-hero__platform">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 5.514 4.486 10 10 10s10-4.486 10-10C22 6.477 17.523 2 12 2zm0 1.5c4.683 0 8.5 3.817 8.5 8.5S16.683 22 12 22 3.5 18.183 3.5 12 7.317 3.5 12 3.5z"/></svg>
            Android
          </span>
          <span class="game-hero__platform">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.4 4.6c-.7-.7-1.5-.7-2.1 0l-6.8 6.8c-.7.7-.7 1.5 0 2.1l3.2 3.2c.7.7 1.5.7 2.1 0l6.8-6.8c.7-.7.7-1.5 0-2.1l-3.2-3.2zm-12.4 5.5c.7-.7 1.5-.7 2.1 0l3.2 3.2c.7.7.7 1.5 0 2.1l-3.2 3.2c-.7.7-1.5.7-2.1 0l-6.8-6.8c-.7-.7-.7-1.5 0-2.1l3.2-3.2c.7-.7 1.5-.7 2.1 0l6.8 6.8c.7.7.7 1.5 0 2.1l-3.2 3.2c-.7.7-1.5.7-2.1 0z"/></svg>
            iOS
          </span>
        </div>
      </div>
      
      <div class="game-hero__visual">
        <div class="game-hero__frame">
          <div class="game-hero__placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2"></rect>
              <path d="M8 21h8M12 17v4"></path>
            </svg>
            <span>Gameplay Trailer / Screenshots folgen</span>
          </div>
          <div class="game-hero__glow" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Features -->
  <section class="section features animate-on-scroll" aria-labelledby="features-title">
    <div class="container">
      <header class="section__header">
        <h2 id="features-title" class="section__title">Features</h2>
        <p class="section__description">Tiefe Systeme, die sich gegenseitig verstärken. Kein Feature existiert isoliert – alles dient deiner Progression.</p>
      </header>
      
      <div class="grid">
        <article class="feature animate-on-scroll">
          <div class="feature__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h3 class="feature__title">Party System</h3>
          <p class="feature__text">Rekrutiere bis zu 5 Helden. Klassen: Arkanist, Wächter, Schatten, Heiler, Beschwörer. Synergien bestimmen den Kampf.</p>
        </article>
        
        <article class="feature animate-on-scroll">
          <div class="feature__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          </div>
          <h3 class="feature__title">Grimoire-Upgrades</h3>
          <p class="feature__text">Dein Buch der Macht. 4 Wissenszweige: Elementar, Arkane, Verboten, Meta. Jeder Rang schaltet neue Mechaniken frei.</p>
        </article>
        
        <article class="feature animate-on-scroll">
          <div class="feature__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 12.79A9 9 0 1 1 14.24 3c.25 0 .52.09.77.28a5 5 0 0 1 4.8 8.51"></path><path d="M12 2v10"></path><path d="M12 20h.01"></path></svg>
          </div>
          <h3 class="feature__title">Ascension & Prestige</h3>
          <p class="feature__text">7 Ascension-Stufen. Jeder Reset gewährt permanente Boni: Wissens-Fragmente, Artefakt-Slots, neue Klassen-Freischaltungen.</p>
        </article>
        
        <article class="feature animate-on-scroll">
          <div class="feature__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
          </div>
          <h3 class="feature__title">Echter Offline Progress</h3>
          <p class="feature__text">Bis zu 24h Offline-Berechnung bei 100% Effizienz. Keine Strafen, keine Timer. Du schließt das Spiel – deine Helden arbeiten weiter.</p>
        </article>
        
        <article class="feature animate-on-scroll">
          <div class="feature__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L2 9.27l5-4.87L9.91 2z"></path></svg>
          </div>
          <h3 class="feature__title">Artefakt-System</h3>
          <p class="feature__text">Sammle 50+ einzigartige Artefakte. Set-Boni, zufällige Affixe, Upgrade-Pfade. Jedes Artefakt erzählt eine Geschichte.</p>
        </article>
        
        <article class="feature animate-on-scroll">
          <div class="feature__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          </div>
          <h3 class="feature__title">Runen & Verzauberung</h3>
          <p class="feature__text">Socket-System für Ausrüstung. Runen verändern Zauber-Verhalten: Kettenblitz → Flächenblitz, Feuerball → Meteor-Regen.</p>
        </article>
      </div>
    </div>
  </section>
  
  <!-- Screenshots -->
  <section class="screenshots animate-on-scroll" aria-labelledby="screenshots-title">
    <div class="container">
      <header class="section__header">
        <h2 id="screenshots-title" class="section__title">Screenshots</h2>
        <p class="section__description">Ein Blick in den Codex. UI, Kampf, Grimoire, Artefakte – alles handgefertigt.</p>
      </header>
      
      <div class="screenshots__carousel" role="list" aria-label="Spiel-Screenshots">
        <!-- Placeholder screenshots - replace with real images -->
        <article class="screenshot" role="listitem">
          <div class="screenshot__frame">
            <div class="game-hero__placeholder" style="height: 100%;">
              <span>Hauptmenü / Codex</span>
            </div>
          </div>
        </article>
        <article class="screenshot" role="listitem">
          <div class="screenshot__frame">
            <div class="game-hero__placeholder" style="height: 100%;">
              <span>Party Management</span>
            </div>
          </div>
        </article>
        <article class="screenshot" role="listitem">
          <div class="screenshot__frame">
            <div class="game-hero__placeholder" style="height: 100%;">
              <span>Auto-Combat</span>
            </div>
          </div>
        </article>
        <article class="screenshot" role="listitem">
          <div class="screenshot__frame">
            <div class="game-hero__placeholder" style="height: 100%;">
              <span>Grimoire Upgrades</span>
            </div>
          </div>
        </article>
        <article class="screenshot" role="listitem">
          <div class="screenshot__frame">
            <div class="game-hero__placeholder" style="height: 100%;">
              <span>Artefakt-Schmiede</span>
            </div>
          </div>
        </article>
        <article class="screenshot" role="listitem">
          <div class="screenshot__frame">
            <div class="game-hero__placeholder" style="height: 100%;">
              <span>Ascension Baum</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
  
  <!-- Stats -->
  <section class="stats animate-on-scroll" aria-labelledby="stats-title">
    <div class="container">
      <header class="section__header" style="margin-bottom: 2rem;">
        <h2 id="stats-title" class="section__title" style="margin-bottom: 0;">Zahlen, die zählen</h2>
      </header>
      <div class="stats__grid">
        <article class="stat animate-on-scroll">
          <div class="stat__value">50+</div>
          <div class="stat__label">Artefakte</div>
        </article>
        <article class="stat animate-on-scroll">
          <div class="stat__value">7</div>
          <div class="stat__label">Ascension Stufen</div>
        </article>
        <article class="stat animate-on-scroll">
          <div class="stat__value">4</div>
          <div class="stat__label">Wissenszweige</div>
        </article>
        <article class="stat animate-on-scroll">
          <div class="stat__value">∞</div>
          <div class="stat__label">Progression</div>
        </article>
      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <section class="cta-section animate-on-scroll" aria-labelledby="cta-game-title">
    <div class="container cta-section__inner">
      <h2 id="cta-game-title" class="cta-section__title">Bereit, den Codex zu öffnen?</h2>
      <p class="cta-section__text">Deine Helden warten. Das Wissen ruft. Die Macht liegt in deinen Händen.</p>
      <div class="cta-section__actions">
        <a href="https://play.google.com/store/apps/details?id=com.grimoireinteractive.codexarcanum" class="btn btn--primary btn--lg" rel="noopener noreferrer">
          <img src="/assets/google-play-badge.svg" alt="Auf Google Play erhalten" height="56">
        </a>
        <a href="https://apps.apple.com/app/idXXXXXXXXXX" class="btn btn--primary btn--lg" rel="noopener noreferrer" style="background: linear-gradient(135deg, #1a1a2e, #16213e); border-color: #0d1b2a;">
          <img src="/assets/app-store-badge.svg" alt="Im App Store laden" height="56">
        </a>
      </div>
    </div>
  </section>
  
  <Footer slot="footer" />
</BaseLayout>