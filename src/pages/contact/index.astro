---
// Contact Page
// ============

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout 
  title="Kontakt – Grimoire Interactive" 
  description="Kontaktieren Sie Grimoire Interactive – Solo Game Dev Studio. Support, Presse, Business, Feedback."
>
  <Header slot="header" />
  
  <section class="hero animate-on-scroll" aria-labelledby="contact-hero-title">
    <div class="container hero__inner">
      <div class="hero__content">
        <div class="hero__publisher-tag">Kontakt</div>
        <h1 id="contact-hero-title" class="hero__title">Schreib uns</h1>
        <p class="hero__subtitle">Ob Feedback, Bug-Report, Presse-Anfrage oder Business – wir lesen alles persönlich.</p>
        
        <div class="hero__cta-group">
          <a href="mailto:contact@grimoire-interactive.de" class="btn btn--primary btn--lg">
            <span class="btn__text">E-Mail schreiben</span>
            <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
          <a href="https://discord.gg/grimoireinteractive" class="btn btn--secondary btn--lg" rel="noopener noreferrer">
            <span class="btn__text">Discord (schneller)</span>
            <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.443.747-.698 1.113a18.27 18.27 0 0 0-5.481 0c-.256-.365-.489-.737-.699-1.113a.077.077 0 0 0-.079-.037 19.736 19.736 0 0 0-4.885 1.515.061.061 0 0 0-.031.022c-.939 1.564-1.482 3.433-1.517 3.706a.068.068 0 0 0 .005.103l.055.043c.06.051 4.178 3.546 4.499 3.759.115.076.254.076.369 0 .34-.223 4.547-3.717 4.614-3.774l.055-.043a.068.068 0 0 0 .005-.103c-.043-.359-.614-2.336-1.608-3.99a.061.061 0 0 0-.031-.022zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419z"/></svg>
          </a>
        </div>
      </div>
      
      <div class="hero__visual">
        <div class="hero__visual-frame">
          <div class="hero__visual-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>Postfach offen</span>
          </div>
          <div class="hero__visual-glow" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section animate-on-scroll" aria-labelledby="contact-channels-title">
    <div class="container">
      <header class="section__header">
        <h2 id="contact-channels-title" class="section__title">Kanäle & Zuständigkeiten</h2>
        <p class="section__description">Der richtige Weg für dein Anliegen – wir antworten meist innerhalb 24–48h (werktags).</p>
      </header>
      
      <div class="grid grid--auto">
        <article class="card animate-on-scroll">
          <div class="card__content" style="text-align:center;">
            <div class="feature__icon" style="margin:0 auto 1rem;" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <h3 class="feature__title">Allgemein & Support</h3>
            <p class="feature__text" style="margin-bottom:1rem;">Fragen zum Spiel, Bugs, Feature-Wünsche, Account-Probleme.</p>
            <a href="mailto:contact@grimoire-interactive.de" class="btn btn--primary" style="width:100%;justify-content:center;">E-Mail öffnen</a>
            <p style="font-size:.8125rem;color:var(--color-ink-muted);margin-top:.5rem;">contact@grimoire-interactive.de</p>
          </div>
        </article>
        
        <article class="card animate-on-scroll">
          <div class="card__content" style="text-align:center;">
            <div class="feature__icon" style="margin:0 auto 1rem;" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.443.747-.698 1.113a18.27 18.27 0 0 0-5.481 0c-.256-.365-.489-.737-.699-1.113a.077.077 0 0 0-.079-.037 19.736 19.736 0 0 0-4.885 1.515.061.061 0 0 0-.031.022c-.939 1.564-1.482 3.433-1.517 3.706a.068.068 0 0 0 .005.103l.055.043c.06.051 4.178 3.546 4.499 3.759.115.076.254.076.369 0 .34-.223 4.547-3.717 4.614-3.774l.055-.043a.068.068 0 0 0 .005-.103c-.043-.359-.614-2.336-1.608-3.99a.061.061 0 0 0-.031-.022zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419z"/></svg>
            </div>
            <h3 class="feature__title">Community & Schnell-Support</h3>
            <p class="feature__text" style="margin-bottom:1rem;">Discord ist der schnellste Weg. Community hilft oft sofort. Devs sind täglich da.</p>
            <a href="https://discord.gg/grimoireinteractive" class="btn btn--primary" style="width:100%;justify-content:center;" rel="noopener noreferrer">Discord beitreten</a>
            <p style="font-size:.8125rem;color:var(--color-ink-muted);margin-top:.5rem;">discord.gg/grimoireinteractive</p>
          </div>
        </article>
        
        <article class="card animate-on-scroll">
          <div class="card__content" style="text-align:center;">
            <div class="feature__icon" style="margin:0 auto 1rem;" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <h3 class="feature__title">Presse & Media</h3>
            <p class="feature__text" style="margin-bottom:1rem;">Review-Codes, Interviews, Press Kit, Assets, Embargo-Infos.</p>
            <a href="mailto:press@grimoire-interactive.de" class="btn btn--secondary" style="width:100%;justify-content:center;">press@grimoire-interactive.de</a>
            <p style="font-size:.8125rem;color:var(--color-ink-muted);margin-top:.5rem;">Press Kit: <a href="/press/" class="legal__contact-link">grimoire-interactive.de/press/</a></p>
          </div>
        </article>
        
        <article class="card animate-on-scroll">
          <div class="card__content" style="text-align:center;">
            <div class="feature__icon" style="margin:0 auto 1rem;" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
            </div>
            <h3 class="feature__title">Business & Partnerschaften</h3>
            <p class="feature__text" style="margin-bottom:1rem;">Publisher-Anfragen, Porting, Localization, Merch, IP-Lizenzierung.</p>
            <a href="mailto:business@grimoire-interactive.de" class="btn btn--secondary" style="width:100%;justify-content:center;">business@grimoire-interactive.de</a>
          </div>
        </article>
        
        <article class="card animate-on-scroll">
          <div class="card__content" style="text-align:center;">
            <div class="feature__icon" style="margin:0 auto 1rem;" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
            <h3 class="feature__title">Datenschutz & Rechtliches</h3>
            <p class="feature__text" style="margin-bottom:1rem;">DSGVO-Anfragen, Löschung, Auskunft, Widerspruch, AVV-Anfragen.</p>
            <a href="mailto:privacy@grimoire-interactive.de" class="btn btn--ghost" style="width:100%;justify-content:center;">privacy@grimoire-interactive.de</a>
            <p style="font-size:.8125rem;color:var(--color-ink-muted);margin-top:.5rem;">DPO: Max Mustermann</p>
          </div>
        </article>
        
        <article class="card animate-on-scroll">
          <div class="card__content" style="text-align:center;">
            <div class="feature__icon" style="margin:0 auto 1rem;" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <h3 class="feature__title">Bug Bounty & Security</h3>
            <p class="feature__section-text" style="margin-bottom:1rem;">Verantwortungsvolle Offenlegung von Sicherheitslücken. Kein öffentliches Issue – direkt mailen.</p>
            <a href="mailto:security@grimoire-interactive.de" class="btn btn--ghost" style="width:100%;justify-content:center;">security@grimoire-interactive.de</a>
            <p style="font-size:.8125rem;color:var(--color-ink-muted);margin-top:.5rem;">PGP Key auf Anfrage</p>
          </div>
        </article>
      </div>
    </div>
  </section>
  
  <section class="section animate-on-scroll" aria-labelledby="postal-title">
    <div class="container">
      <header class="section__header">
        <h2 id="postal-title" class="section__title">Postadresse</h2>
      </header>
      
      <article class="card animate-on-scroll" style="max-width: 480px; margin: 0 auto;">
        <div class="card__content" style="text-align:center;">
          <div class="feature__icon" style="margin:0 auto 1rem;" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <h3 class="feature__title">Grimoire Interactive</h3>
          <address style="font-style:normal;color:var(--color-ink-dim);line-height:1.8;margin-bottom:1rem;">
            Max Mustermann<br>
            Musterstraße 123<br>
            12345 Musterstadt<br>
            Deutschland
          </address>
          <p style="font-size:.8125rem;color:var(--color-ink-muted);">Für postalische Anfragen nur nach vorheriger E-Mail-Absprache. Unaufgeforderte Sendungen können nicht bearbeitet werden.</p>
        </div>
      </article>
    </div>
  </section>
  
  <section class="cta-section animate-on-scroll" aria-labelledby="cta-contact-title">
    <div class="container cta-section__inner">
      <h2 id="cta-contact-title" class="cta-section__title">Bevor du schreibst…</h2>
      <p class="cta-section__text">Viele Fragen beantworten sich selbst. Schau kurz rein:</p>
      <div class="cta-section__actions">
        <a href="/privacy/#7-ihr-rechte" class="btn btn--secondary btn--lg">Datenschutz-Rechte (DSGVO)</a>
        <a href="/terms/" class="btn btn--secondary btn--lg">AGB & EULA</a>
        <a href="/cookies/" class="btn btn--secondary btn--lg">Cookie-Richtlinie</a>
        <a href="https://discord.gg/grimoireinteractive" class="btn btn--primary btn--lg" rel="noopener noreferrer">
          <span class="btn__text">Discord #support</span>
          <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.443.747-.698 1.113a18.27 18.27 0 0 0-5.481 0c-.256-.365-.489-.737-.699-1.113a.077.077 0 0 0-.079-.037 19.736 19.736 0 0 0-4.885 1.515.061.061 0 0 0-.031.022c-.939 1.564-1.482 3.433-1.517 3.706a.068.068 0 0 0 .005.103l.055.043c.06.051 4.178 3.546 4.499 3.759.115.076.254.076.369 0 .34-.223 4.547-3.717 4.614-3.774l.055-.043a.068.068 0 0 0 .005-.103c-.043-.359-.614-2.336-1.608-3.99a.061.061 0 0 0-.031-.022zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419z"/></svg>
        </a>
      </div>
    </div>
  </section>
  
  <Footer slot="footer" />
</BaseLayout>