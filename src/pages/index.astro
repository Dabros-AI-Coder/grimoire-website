---
// Home Page
// =========

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Grimoire Interactive – Solo Game Dev Studio" description="Grimoire Interactive erschafft tiefgründige Idle RPGs. Unser erstes Spiel: Codex Arcanum – ein arkanes Idle RPG mit Party-System, Prestige & Offline-Progression.">
  <Header slot="header" />
  
  <!-- Hero Section -->
  <section class="hero animate-on-scroll" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__content">
        <div class="hero__publisher-tag">A Grimoire Interactive Game</div>
        <h1 id="hero-title" class="hero__title">CODEX ARCANUM</h1>
        <p class="hero__subtitle">Ein tiefgründiges Idle RPG über arkanen Wissen, Heldenparteien und endlose Aufstiege.</p>
        
        <div class="hero__cta-group">
          <a href="/codex-arcanum/" class="btn btn--primary btn--lg">
            <span class="btn__text">Mehr erfahren</span>
            <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="https://discord.gg/grimoireinteractive" class="btn btn--secondary btn--lg" rel="noopener noreferrer">
            <span class="btn__text">Discord beitreten</span>
            <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.443.747-.698 1.113a18.27 18.27 0 0 0-5.481 0c-.256-.365-.489-.737-.699-1.113a.077.077 0 0 0-.079-.037 19.736 19.736 0 0 0-4.885 1.515.061.061 0 0 0-.031.022c-.939 1.564-1.482 3.433-1.517 3.706a.068.068 0 0 0 .005.103l.055.043c.06.051 4.178 3.546 4.499 3.759.115.076.254.076.369 0 .34-.223 4.547-3.717 4.614-3.774l.055-.043a.068.068 0 0 0 .005-.103c-.043-.359-.614-2.336-1.608-3.99a.061.061 0 0 0-.031-.022zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419z"/>
            </svg>
          </a>
        </div>
        
        <div class="hero__trust">
          <div class="hero__trust-item">
            <span class="hero__trust-value">1</span>
            <span>Entwickler</span>
          </div>
          <div class="hero__trust-item">
            <span class="hero__trust-value">∞</span>
            <span>Progression</span>
          </div>
          <div class="hero__trust-item">
            <span class="hero__trust-value">100%</span>
            <span>Offline Progress</span>
          </div>
          <div class="hero__trust-item">
            <span class="hero__trust-value">0</span>
            <span>Pay-to-Win</span>
          </div>
        </div>
      </div>
      
      <div class="hero__visual">
        <div class="hero__visual-frame">
          <div class="hero__visual-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
            </svg>
            <span>Key Art kommt bald</span>
          </div>
          <div class="hero__visual-glow" aria-hidden="true"></div>
        </div>
        <div class="hero__scroll" aria-hidden="true">
          <span>Mehr entdecken</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M19 12l-7 7-7-7"></path>
          </svg>
        </div>
      </div>
    </div>
  </section>
  
  <!-- About Studio Section -->
  <section class="section animate-on-scroll" aria-labelledby="about-title">
    <div class="container">
      <header class="section__header">
        <span class="section__label">Studio</span>
        <h2 id="about-title" class="section__title">Grimoire Interactive</h2>
        <p class="section__description">Solo Game Dev aus Leidenschaft. Kein Publisher, kein Druck – nur tiefe Systeme, faire Monetarisierung und Spiele, die respektieren, wie du spielst.</p>
      </header>
      
      <div class="grid grid--2">
        <article class="card animate-on-scroll">
          <div class="card__content">
            <h3 class="card__title">Solo Development</h3>
            <p class="card__text">Ein Entwickler, volle kreative Kontrolle. Jede Entscheidung dient dem Spiel – nicht einem Quartalsbericht.</p>
          </div>
        </article>
        
        <article class="card animate-on-scroll">
          <div class="card__content">
            <h3 class="card__title">Idle RPGs mit Tiefe</h3>
            <p class="card__text">Keine leeren Clicker. Echte RPG-Systeme: Builds, Synergien, Theoriecrafting – alles läuft auch offline weiter.</p>
          </div>
        </article>
        
        <article class="card animate-on-scroll">
          <div class="card__content">
            <h3 class="card__title">Fair Play</h3>
            <p class="card__text">Keine Energy-Systeme, keine zwangsweisen Ads, kein Pay-to-Win. Du kaufst das Spiel – oder spielst kostenlos mit vollem Umfang.</p>
          </div>
        </article>
        
        <article class="card animate-on-scroll">
          <div class="card__content">
            <h3 class="card__title">Community First</h3>
            <p class="card__text">Entwicklung im Dialog. Discord, Dev-Blogs, offene Roadmaps. Dein Feedback formt das Spiel.</p>
          </div>
        </article>
      </div>
    </div>
  </section>
  
  <!-- Current Game Section -->
  <section class="section animate-on-scroll" aria-labelledby="current-game-title">
    <div class="container">
      <header class="section__header">
        <span class="section__label">Aktuelles Spiel</span>
        <h2 id="current-game-title" class="section__title">Codex Arcanum</h2>
        <p class="section__description">Unser Debüt: Ein arkanes Idle RPG über verbotene Bücher, Heldenparteien und die Jagd nach ultimativer Macht.</p>
      </header>
      
      <article class="card animate-on-scroll" style="max-width: 900px; margin: 0 auto;">
        <div class="card__media">
          <div class="hero__visual-placeholder" style="height: 100%;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
            </svg>
            <span>Gameplay Screenshots folgen</span>
          </div>
        </div>
        <div class="card__content">
          <div class="card__meta" style="display:flex;gap:.5rem;margin-bottom:.5rem;flex-wrap:wrap;">
            <span class="badge">Idle RPG</span>
            <span class="badge badge--amethyst">Party System</span>
            <span class="badge badge--emerald">Prestige</span>
          </div>
          <h3 class="card__title" style="font-size: 1.75rem;">Codex Arcanum</h3>
          <p class="card__text" style="font-size: 1.0625rem; margin-bottom: 1.5rem;">Erkunde die verbotenen Seiten des Codex Arcanum. Rekrutiere Helden, meistere arkanen Künste, schmiede Artefakte und steige immer weiter auf – jede Wiedergeburt macht dich mächtiger.</p>
          <div class="card__footer">
            <a href="/codex-arcanum/" class="btn btn--primary">
              <span class="btn__text">Zur Spielseite</span>
              <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
            <a href="https://discord.gg/grimoireinteractive" class="btn btn--secondary" rel="noopener noreferrer">Discord</a>
          </div>
        </div>
      </article>
    </div>
  </section>
  
  <!-- Newsletter / CTA Section -->
  <section class="cta-section animate-on-scroll" aria-labelledby="cta-title">
    <div class="container cta-section__inner">
      <h2 id="cta-title" class="cta-section__title">Bleib auf dem Laufenden</h2>
      <p class="cta-section__text">Kein Spam, nur echte Updates: Dev-Blogs, Patchnotes, Early Access Infos und exklusive Einblicke.</p>
      <div class="cta-section__actions">
        <a href="https://discord.gg/grimoireinteractive" class="btn btn--primary btn--lg" rel="noopener noreferrer">
          <span class="btn__text">Discord beitreten</span>
          <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.443.747-.698 1.113a18.27 18.27 0 0 0-5.481 0c-.256-.365-.489-.737-.699-1.113a.077.077 0 0 0-.079-.037 19.736 19.736 0 0 0-4.885 1.515.061.061 0 0 0-.031.022c-.939 1.564-1.482 3.433-1.517 3.706a.068.068 0 0 0 .005.103l.055.043c.06.051 4.178 3.546 4.499 3.759.115.076.254.076.369 0 .34-.223 4.547-3.717 4.614-3.774l.055-.043a.068.068 0 0 0 .005-.103c-.043-.359-.614-2.336-1.608-3.99a.061.061 0 0 0-.031-.022zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.007-2.419 2.2-2.419 1.167 0 2.157.967 2.157 2.301 0 1.21-.913 2.419-2.2 2.419z"/></svg>
        </a>
        <a href="https://twitter.com/GrimoireInteractive" class="btn btn--secondary btn--lg" rel="noopener noreferrer">
          <span class="btn__text">Auf X folgen</span>
          <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 9.24-3.933.928-7.874-8.88-5.77 5.513 3.662.92 3.523-4.105-5.962-5.327L5.81 21.63 2.5 22.5l9.17-1.89-5.242-5.356 7.677-2.06 1.379-6.132h-3.383l2.48 3.096-5.352 4.102 5.818 5.052L21.5 21.75l-3.256-19.5h-3.308z"/></svg>
        </a>
      </div>
    </div>
  </section>
  
  <Footer slot="footer" />
</BaseLayout>