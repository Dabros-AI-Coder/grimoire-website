---
// 404 Page
// ========

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="Seite nicht gefunden – 404" 
  description="Die gesuchte Seite existiert nicht. Grimoire Interactive."
  noIndex={true}
>
  <Header slot="header" />
  
  <section class="hero" style="min-height: 70vh;" aria-labelledby="error-title">
    <div class="container">
      <div class="hero__inner" style="grid-template-columns: 1fr; text-align: center;">
        <div class="hero__content">
          <div class="hero__publisher-tag" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border-color: rgba(239, 68, 68, 0.3);">
            404
          </div>
          <h1 id="error-title" class="hero__title" style="@include text-gradient(#ef4444, #f87171);">Seite nicht gefunden</h1>
          <p class="hero__subtitle">Der Codex enthält diese Seite nicht. Vielleicht wurde sie nie geschrieben – oder ist in den verbotenen Archiven verloren gegangen.</p>
          
          <div class="hero__cta-group" style="justify-content: center; margin-top: 2rem;">
            <a href="/" class="btn btn--primary btn--lg">
              <span class="btn__text">Zurück zum Grimoire</span>
              <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            </a>
            <a href="/codex-arcanum/" class="btn btn--secondary btn--lg">
              <span class="btn__text">Codex Arcanum öffnen</span>
              <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
            </a>
          </div>
          
          <div class="hero__trust" style="margin-top: 3rem; border-color: rgba(239, 68, 68, 0.2);">
            <a href="/about/" class="hero__trust-item" style="text-decoration:none;color:inherit;">
              <span class="hero__trust-value" style="@include text-gradient(#ef4444, #f87171);">?</span>
              <span>Über uns</span>
            </a>
            <a href="/contact/" class="hero__trust-item" style="text-decoration:none;color:inherit;">
              <span class="hero__trust-value" style="@include text-gradient(#ef4444, #f87171);">✉</span>
              <span>Kontakt</span>
            </a>
            <a href="https://discord.gg/grimoireinteractive" class="hero__trust-item" style="text-decoration:none;color:inherit;" rel="noopener noreferrer">
              <span class="hero__trust-value" style="@include text-gradient(#ef4444, #f87171);">💬</span>
              <span>Discord</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <Footer slot="footer" />
</BaseLayout>